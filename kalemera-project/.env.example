# ---------------------------------------------------------------------------
# Kalemera configuration
#
# Local (plain Python) runs need no .env file at all: the backend defaults to
# a SQLite file at backend/kalemera.db and stores uploads in backend/uploads.
#
# Docker Compose overrides DATABASE_URL and UPLOAD_DIR per service, so the
# values below only configure the shared bits (Postgres credentials used by
# the db container, JWT secrets, upload limits).
# ---------------------------------------------------------------------------

# Database (used by the Docker Compose db service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=kalemera

# To run locally against PostgreSQL instead of SQLite, uncomment and set:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kalemera

# Security & JWT
# NEVER commit a real secret here. Generate one locally, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
# and set it only in your local .env (gitignored) or your deployment platform's
# environment variable settings — never in this template file.
SECRET_KEY=REPLACE_WITH_A_LOCALLY_GENERATED_SECRET_NEVER_COMMIT_REAL_VALUE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Upload Configurations
# UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=2097152

# Business Hours (order acceptance window)
# BUSINESS_TIMEZONE=Africa/Cairo
# ENABLE_BUSINESS_HOURS=true
# BUSINESS_CLOSE_HOUR=23

# Cloud Object Storage (S3 / Cloudflare R2 / Supabase Storage)
# REQUIRED in any serverless/ephemeral-filesystem deployment (e.g. Vercel).
# Without these set, the backend will refuse to start when it detects it is
# running on Vercel/Lambda, rather than silently writing uploads to ephemeral
# /tmp storage that is lost on every redeploy/cold start.
# S3_BUCKET_NAME=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION_NAME=
# S3_ENDPOINT_URL=
# S3_PUBLIC_URL=