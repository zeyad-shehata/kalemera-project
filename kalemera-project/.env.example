# ---------------------------------------------------------------------------
# Kalemera configuration
#
# Local (plain Python) runs need no .env file at all: the backend defaults to
# a SQLite file at backend/kalemera.db and stores uploads in backend/uploads.
#
# Docker Compose overrides DATABASE_URL and UPLOAD_DIR per service, so the
# values below only configure the shared bits (Postgres credentials used by
# the db container, JWT secrets, upload limits).
# ---------------------------------------------------------------------------

# Database (used by the Docker Compose db service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=kalemera

# To run locally against PostgreSQL instead of SQLite, uncomment and set:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kalemera

# Security & JWT
SECRET_KEY=38fd73b22cfc1b3fbc53b27b5e40e698889cd649f8be7cf6748a0f8b85295c5d
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Upload Configurations
# UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=2097152

# Business Hours (order acceptance window)
# BUSINESS_TIMEZONE=Africa/Cairo
# ENABLE_BUSINESS_HOURS=true
# BUSINESS_CLOSE_HOUR=23